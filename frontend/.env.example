# ==============================================================================
# DMS AI Platform — Frontend Environment Configuration Example
# ==============================================================================
# Salin file ini menjadi `frontend/.env` lalu sesuaikan nilainya:
# cp .env.example .env
# ==============================================================================

# URL Backend API (FastAPI)
# Gunakan http://127.0.0.1:8000 untuk pengembangan lokal,
# atau ganti dengan IP LAN / domain publik server produksi (misal: http://192.168.1.50:8000).
VITE_API_URL=http://127.0.0.1:8000

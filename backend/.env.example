# ==============================================================================
# DMS AI Platform — Backend Environment Configuration Example
# ==============================================================================
# Salin file ini menjadi `backend/.env` lalu sesuaikan nilainya:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CORE (PostgreSQL Inti Platform)
# ------------------------------------------------------------------------------
# Database PostgreSQL utama untuk tabel users, tenants, audit_logs, global_kb, dll.
CORE_DB_HOST=localhost
CORE_DB_PORT=5433
CORE_DB_NAME=ai-dms
CORE_DB_USER=postgres
CORE_DB_PASSWORD=postgres

# ------------------------------------------------------------------------------
# 2. REDIS (Session, Cache, & Distributed Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. KEAMANAN & ENKRIPSI (WAJIB DIISI)
# ------------------------------------------------------------------------------
# Kunci JWT untuk otentikasi login (minimal 32 karakter acak).
# Contoh generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=isi_dengan_kunci_acak_minimal_32_karakter_di_sini

# Masa berlaku access token JWT dalam satuan menit (default: 1440 = 24 jam)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Kunci Fernet untuk enkripsi password database tenant & API key provider AI.
# Wajib digenerate dengan: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=isi_dengan_fernet_key_base64_di_sini

# ------------------------------------------------------------------------------
# 4. CORS & NETWORKING
# ------------------------------------------------------------------------------
# Origin tambahan yang diizinkan memanggil API selain localhost/127.0.0.1.
# Pisahkan beberapa URL dengan koma (misal: http://192.168.1.50:5173,https://ai.dealer.com).
CORS_ORIGINS=

# ------------------------------------------------------------------------------
# 5. PEMBATASAN & KINERJA EKSEKUSI QUERY (GERBANG KEAMANAN #6)
# ------------------------------------------------------------------------------
# Batas waktu maksimal query dieksekusi di database cabang (default: 10s = 10 detik).
STATEMENT_TIMEOUT=10s

# Batas maksimal baris data yang diambil dari database tenant per pertanyaan (default: 500 baris).
QUERY_ROW_CAP=500

# Batas laju pertanyaan (Rate Limiting) per user (default: 10 request per 60 detik).
CHAT_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW=60

# ------------------------------------------------------------------------------
# 6. PROVIDER AI & KNOWLEDGE BASE
# ------------------------------------------------------------------------------
# Timeout panggilan HTTP ke API LLM pihak ketiga dalam satuan detik (default: 60.0).
LLM_TIMEOUT_SECONDS=60.0

# Jumlah contoh query emas (Q -> SQL) yang disuntikkan ke prompt AI (default: 5).
FEWSHOT_MAX_EXAMPLES=5

# Manajemen Connection Pool Database Tenant (LRU Cache)
TENANT_MAX_POOLS=8
TENANT_POOL_MAX_SIZE=2
TENANT_IDLE_TIMEOUT_SECONDS=600.0

# Vanna API (Opsional: hanya jika ingin sync snapshot dari legacy Vanna server)
VANNA_API_URL=
VANNA_API_USER=
VANNA_API_PASSWORD=
